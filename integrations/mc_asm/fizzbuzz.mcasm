; FizzBuzz in mc.asm. Every token is A1Z26; a token starting with
; 0 is a number written as its decimal digits.
; Run:    python mc_asm.py fizzbuzz.mcasm
; Read:   python mc_asm.py fizzbuzz.mcasm --decode

0-1 0-0 19-20-15-18-5                                      ; i = 1
23-8-9-12-5 0-0 12-15-1-4 0-1-6 12-20 4-15                 ; while i < 16:
0-0 12-15-1-4 0-1-5 13-15-4 0-0 5-17 9-6                   ; if i % 15 == 0:
0-6 5-13-9-20 0-9 5-13-9-20 0-2-6 5-13-9-20 0-2-6 5-13-9-20 0-2 5-13-9-20 0-2-1 5-13-9-20 0-2-6 5-13-9-20 0-2-6 5-13-9-20 ; print FIZZBUZZ
5-12-19-5 0-0 12-15-1-4 0-3 13-15-4 0-0 5-17 9-6           ; elif i % 3 == 0:
0-6 5-13-9-20 0-9 5-13-9-20 0-2-6 5-13-9-20 0-2-6 5-13-9-20 ; print FIZZ
5-12-19-5 0-0 12-15-1-4 0-5 13-15-4 0-0 5-17 9-6           ; elif i % 5 == 0:
0-2 5-13-9-20 0-2-1 5-13-9-20 0-2-6 5-13-9-20 0-2-6 5-13-9-20 ; print BUZZ
5-12-19-5 0-0 12-15-1-4 16-18-9-14-20                      ; else print i
5-14-4 5-14-4 5-14-4 14-12                                 ; close the three ifs, newline
0-0 12-15-1-4 0-1 1-4-4 0-0 19-20-15-18-5                  ; i = i + 1
5-14-4                                                     ; end while
