# AttestorVonLuneberg -- API keys.
#
# Copy this file to `keys.env` (same folder) and uncomment + fill in the ones you
# have. `keys.env` is gitignored, and Attestor never loads a project's cwd `.env`.
# Only documented provider variables are accepted. Anything you set in the shell
# (e.g. $env:GROQ_API_KEY) still wins over this file.
#
# Then just run the tools -- they load this automatically:
#     python3 superattestor.py "write a trie" --curry
#     python3 forge.py "an LRU cache" --model qwen/qwen3-32b

# --- Groq: free, generous, serves Qwen/Llama. The best starting point. ---
# get a key at console.groq.com/keys   (starts with gsk_)
# GROQ_API_KEY=gsk_your_key_here
# GROQ_MODEL=qwen/qwen3-32b

# --- OpenRouter: aggregator; free models carry a :free tag. ---
# get a key at openrouter.ai/keys      (starts with sk-or-v1-)
# OPENROUTER_API_KEY=sk-or-v1-your_key_here
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Mistral: Codestral for code. ---
# get a key at console.mistral.ai/api-keys
# MISTRAL_API_KEY=your_key_here
# MISTRAL_MODEL=codestral-latest

# --- Ollama: local models, NO key. Just name the model you pulled. ---
# install from ollama.com, then `ollama pull qwen2.5-coder`
# OLLAMA_MODEL=qwen2.5-coder
# OLLAMA_HOST=http://localhost:11434
# Remote hosts are blocked by default. For a server you explicitly trust only:
# ATTESTOR_ALLOW_REMOTE_OLLAMA=1

# --- Google AI Studio (Gemini): the 429 machine; benched in superattestor. ---
# get a key at aistudio.google.com/app/apikey
# GEMINI_API_KEY=your_key_here

# --- OpenAI: paid, no free tier. ---
# OPENAI_API_KEY=sk-your_key_here
